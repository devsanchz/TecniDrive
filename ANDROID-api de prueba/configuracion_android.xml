<!-- ══════════════════════════════════════════════════════════════
     PASO 1 — AndroidManifest.xml
     Agrega estos permisos DENTRO de <manifest> y ANTES de <application>
     Archivo: app/src/main/AndroidManifest.xml
═══════════════════════════════════════════════════════════════ -->

<!-- Permiso de Internet (obligatorio) -->
<uses-permission android:name="android.permission.INTERNET" />

<!-- Permiso para conexiones HTTP en redes locales (Android 9+) -->
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


<!-- ══════════════════════════════════════════════════════════════
     PASO 1b — Dentro de <application> agrega usesCleartextTraffic
     Esto permite HTTP (sin SSL) que usa XAMPP por defecto
═══════════════════════════════════════════════════════════════ -->

<!--
<application
    ...
    android:usesCleartextTraffic="true"   ← AGREGA ESTA LÍNEA
    ...>
-->


